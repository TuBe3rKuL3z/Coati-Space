<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ставропольский зоопарк</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Coati_Space_Project.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-success" href="/stav-zoo">🦝 Ставропольский зоопарк</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/stav-zoo">Зоопарк</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-success fw-semibold" href="/stav-zoo/coati">Носуха Чип</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-danger" href="/stav-zoo/coati#webcam-section">🔴 Веб-камера</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning text-dark" href="/stav-zoo/coati#donation-section">❤️ Донат</a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-primary fw-semibold" href="/diary">📖 Дневник наблюдений</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item me-2">
                                <span class="badge bg-light text-dark border p-2">👤 @User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-danger btn-sm px-3" href="/account/logout">Выйти</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-secondary btn-sm px-3" href="/account/login">Вход для сотрудников</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 bg-light mt-auto">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <div>
                &copy; 2026 - <strong>Ставропольский зоопарк</strong> • Coati Space Project
            </div>
            <div class="d-flex flex-wrap gap-3 small">
                <a href="/stav-zoo" class="text-decoration-none text-muted">Главная зоопарка</a>
                <a href="/stav-zoo/coati" class="text-decoration-none text-muted">Носуха Чип</a>
                <a href="/api/coati" target="_blank" class="text-decoration-none text-muted">API (Сводка)</a>
                <a href="/api/coati/diary" target="_blank" class="text-decoration-none text-muted">API (Журнал)</a>
                <a href="/account/login" class="text-decoration-none text-muted">Служебный вход</a>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model IEnumerable<Coati_Space_Project.Models.DiaryEntry>
@{
    ViewData["Title"] = "Журнал наблюдений за носухой";
    string currentFilter = ViewBag.CurrentFilter ?? "Все";
    var categories = new[] { "Все", "Кормление", "Медосмотр", "Спаривание", "Потомство", "Активность" };
}

<div class="d-flex justify-content-between align-items-center flex-wrap mb-4 pb-2 border-bottom">
    <div>
        <h2 class="fw-bold text-dark mb-1">Журнал наблюдений: Носуха «Хахатуха»</h2>
        <span class="text-secondary small">
            Администратор: <strong>@User.Identity?.Name</strong>
        </span>
    </div>
    <div class="d-flex gap-2 mt-2 mt-md-0">
        <a asp-action="Create" class="btn btn-success shadow-sm">
            Добавить запись
        </a>
        <a href="/stav-zoo/coati" class="btn btn-outline-secondary">
            На страницу носухи
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Фильтрация по типам событий -->
<div class="card shadow-sm border mb-4 bg-white">
    <div class="card-body p-3">
        <div class="d-flex align-items-center flex-wrap gap-2">
            <span class="fw-semibold text-dark small me-2">Фильтр по категории:</span>
            @foreach (var cat in categories)
            {
                if (cat == currentFilter)
                {
                    <a asp-action="Index" asp-route-filterType="@cat" class="btn btn-sm btn-dark">@cat</a>
                }
                else
                {
                    <a asp-action="Index" asp-route-filterType="@cat" class="btn btn-sm btn-outline-secondary">@cat</a>
                }
            }
        </div>
    </div>
</div>

<!-- Список событий -->
@if (!Model.Any())
{
    <div class="alert alert-light border text-center py-4 text-secondary">
        В выбранной категории записей не найдено. Нажмите «Добавить запись», чтобы внести новое наблюдение.
    </div>
}
else
{
    <div class="card shadow-sm border overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 140px;">Дата и время</th>
                        <th style="width: 130px;">Категория</th>
                        <th>Тема и содержание события</th>
                        <th style="width: 170px;">Сотрудник</th>
                        <th style="width: 220px;" class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="fw-semibold text-dark">@item.EventDate.ToString("dd.MM.yyyy")</span>
                                <div class="small text-secondary">@item.EventDate.ToString("HH:mm")</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1">@item.EventType</span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark mb-1">@item.Title</div>
                                <div class="text-secondary small">@item.Description</div>
                            </td>
                            <td>
                                <span class="small text-dark">@item.Author</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm me-1">
                                    Редактировать
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                                    Удалить
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

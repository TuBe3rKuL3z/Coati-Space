@model Coati_Space_Project.Models.DiaryEntry
@{
    ViewData["Title"] = "Удаление события #" + Model.Id;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0 fw-bold">⚠️ Подтверждение удаления записи</h4>
            </div>
            <div class="card-body p-4">
                <p class="text-danger fw-semibold">Вы уверены, что хотите удалить данное событие из журнала наблюдений?</p>

                <div class="p-3 bg-light rounded border mb-4">
                    <div class="mb-2"><strong>ID:</strong> #@Model.Id</div>
                    <div class="mb-2"><strong>Дата:</strong> @Model.EventDate.ToString("dd.MM.yyyy HH:mm")</div>
                    <div class="mb-2"><strong>Категория:</strong> <span class="badge bg-secondary">@Model.EventType</span></div>
                    <div class="mb-2"><strong>Тема:</strong> @Model.Title</div>
                    <div class="mb-2"><strong>Описание:</strong> @Model.Description</div>
                    <div><strong>Автор:</strong> @Model.Author</div>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">← Отмена</a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold">
                            🗑️ Да, удалить запись
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

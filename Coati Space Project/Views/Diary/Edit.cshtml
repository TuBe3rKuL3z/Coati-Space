@model Coati_Space_Project.Models.DiaryEntry
@{
    ViewData["Title"] = "Редактирование события #" + Model.Id;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold">✏️ Редактирование записи #@Model.Id</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CoatiId" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="EventDate" class="form-label fw-semibold">Дата и время:</label>
                            <input asp-for="EventDate" type="datetime-local" class="form-control" value="@Model.EventDate.ToString("yyyy-MM-ddTHH:mm")" required />
                            <span asp-validation-for="EventDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EventType" class="form-label fw-semibold">Категория:</label>
                            <select asp-for="EventType" class="form-select" required>
                                <option value="Кормление">🍎 Кормление</option>
                                <option value="Медосмотр">🩺 Медосмотр</option>
                                <option value="Спаривание">❤️ Спаривание</option>
                                <option value="Потомство">🐾 Потомство</option>
                                <option value="Активность">🏃 Активность</option>
                                <option value="Уборка">🧹 Уборка</option>
                            </select>
                            <span asp-validation-for="EventType" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Тема события:</label>
                        <input asp-for="Title" class="form-control" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Подробное описание:</label>
                        <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Author" class="form-label fw-semibold">Автор записи:</label>
                        <input asp-for="Author" class="form-control" required />
                        <span asp-validation-for="Author" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">← Отмена</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                            💾 Сохранить изменения
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

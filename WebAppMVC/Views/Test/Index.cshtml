@{
    string morning = "Доброе утро!";
    string day = "Добрый день!";
    string evening = "Добрый вечер!";
    string night = "Доброй ночи.";
    int now = DateTime.Now.Hour;
}
<DOCTYPE html>
    <html>
    <head>
        <title>IT TOP COLLEGE</title>
        <meta charset="utf-8" />
    </head>
    <body>
        <h1>@ViewData["Title"]</h1>
        <h1>@ViewBag.Message:</h1>
        @if (now > 5 && now < 12)
            {
                <h2>@morning</h2>
            }
        else if (now > 12 && now < 18)
            {
                <h2>@day</h2>
            }
        else if (now > 18 && now < 24)
            {
                <h2>@evening</h2>
            }
        else
            {
                <h2>@night</h2>
            }

        <h3>Сегодня: @DateTime.Now.ToLongDateString()</h3>
        <p>2 + 2 = @Sum(2, 2)</p>
        <p>2 - 2 = @Sub(2, 2)</p>
        <p>2 * 2 = @Mult(2, 2)</p>
        <p>2 / 2 = @Div(2, 2)</p>
        <p>@*comment*@</p>
        <p>Сейчас: @DateTime.Now.ToLongTimeString()</p>
        @{
            string[] students = {
                "Александрова", "Антонов", "Золин", "Кубанов",
                "Лушников", "Метелицин","Чавычалов"
            };
        }
        <p>На паре присутствуют: @students.Length</p>
        @*<ol>
            @for (int i = 0; i < students.Length; i++)
                {
                    <li>@students[i]</li>
                }
        </ol> *@
        <ul>
            @foreach(var student in students)
                {
                    <li>@student</li>
                }
        </ul>
        @functions
            {
            public int Sum(int x, int y)
            {
                return x + y;
            }
            public int Sub(int x, int y)
            {
                return x - y;
            }
            public int Mult(int x, int y)
            {
                return x * y;
            }
            public int Div(int x, int y)
            {
                return x / y;
            }
        }
    </body>
</html>